# --- LLM providers ---
# Set at least one. LLM_PROVIDER picks the default for chat completions.
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults are set in src/lib/llm/chat.ts)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o

# --- Embeddings ---
# Only OpenAI embeddings are wired up (Anthropic has no embeddings model).
EMBEDDING_PROVIDER=openai         # openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Vector store (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=helix_policies

# --- Retrieval tuning ---
# top-k pulled from the vector store per query
RETRIEVAL_TOP_K=5
# Cosine similarity floor. Below this, the agent should DEFER (LOW_CONFIDENCE).
# Tuned via npm run sweep against the 50-ticket eval set — 0.30 scored 100%
# (zero false_resolve, zero missed_resolve) on the baseline run. See
# reports/sweeps/ for the calibration history.
RETRIEVAL_SCORE_THRESHOLD=0.30
# Number of LLM-generated paraphrases for multi-query fusion (0 to disable).
RETRIEVAL_QUERY_VARIANTS=2

# --- Reranking (Cohere) — opt-in ---
# Optional cross-encoder rerank on top of cosine retrieval. At our current
# corpus size the eval sweep shows no meaningful lift, but it's wired up
# for when the corpus grows or the eval gets more adversarial.
COHERE_API_KEY=
RAG_RERANK_ENABLED=false
RERANK_MODEL=rerank-v3.5
# Candidates pulled from Qdrant before reranking (reranker keeps top RETRIEVAL_TOP_K).
RERANK_CANDIDATE_K=20

# --- JIRA connector (optional) ---
# Leave blank to run the agent without JIRA wiring (triage CLI still works).
# Cloud site URL — e.g. https://yourco.atlassian.net (no trailing slash)
JIRA_BASE_URL=
# Atlassian account email + API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
# Project key — used as the default JQL scope (e.g. HELPDESK)
JIRA_PROJECT_KEY=
# Override the default JQL ('project = <KEY> AND status = "Waiting for triage"').
# JIRA_QUEUE_JQL=project = HELPDESK AND status = "Waiting for triage"
# Poller cadence in ms (default 30s).
JIRA_POLL_INTERVAL_MS=30000
# Transition ids for the agent's decisions. Discover via:
#   npx tsx -e 'import("./src/lib/jira").then(m=>m.listTransitions(m.buildClientFromEnv()!, "HELPDESK-1").then(console.log))'
# RESOLVE → e.g. "Resolved"; DEFER → e.g. "Waiting for Support".
JIRA_RESOLVE_TRANSITION_ID=
JIRA_DEFER_TRANSITION_ID=
# Shared secret expected on the webhook (header `x-webhook-secret` or `?secret=`).
# Optional; if unset, the webhook is open.
JIRA_WEBHOOK_SECRET=
# Atlassian-account email to assign triaged tickets to (both RESOLVE + DEFER).
# Resolved to accountId once per run. Leave blank to skip auto-assignment.
JIRA_ASSIGNEE_EMAIL=
